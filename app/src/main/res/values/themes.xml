<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Vortex" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/vortex_graphite</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <!-- Splash: la espiral se dibuja sobre grafito antes del primer frame de Compose -->
    <style name="Theme.Vortex.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vortex_graphite</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_vortex_mark</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Vortex</item>
    </style>

    <!-- El reproductor va a pantalla completa real, sin fondo claro en ningún frame -->
    <style name="Theme.Vortex.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>

</resources>
